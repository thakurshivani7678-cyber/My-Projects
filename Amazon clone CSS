*{
    margin:0px;
    font-family:arial, sans-serif;
    box-sizing:border-box;
}
.navbar{
    height:60px;
    background-color :#0f1111;
    color:white;
    display:flex;
    align-items: center;
    justify-content:space-evenly;
    
}
/* box1 */
.nav-logo{
    height:50px;
    width:90px;
}
.logo-nav{
    background-image: url("amazon_logo.jpg");
    background-size:cover;
    height:40px;
    width:80px;

}
.border{
    border: 1.5px solid transparent;
}
.border:hover{
    border: 1.5px solid white;
}
/* box2 */
.icon1{
    color: #cccccc;
    font-size:0.5rem;
    margin-left:15px;
}
.icon2{
    color: #ffffff;
    font-size: 0.75rem;
    margin-left:3px;
}
.nav_icon{
    display: flex;
    align-items:center;

}

/* box3 */
.nav-search{
    display:flex;
    height:32px;
    width: 400px;
    border-radius:4px;
    background-color:antiquewhite;
    justify-content:space-evenly;
}
.search-select{
    background-color: #f3f3f3;
    border:none;
    width:50px;
    text-align:center;
    border-top-left-radius:4px ;
    border-bottom-left-radius: 4px;
}
.search-input{
    width:100%;
    border:none;
    font-size:1rem;
}
.search-icon{
    display:flex;
    width:45px;
    justify-content: center;
    align-items: center;
    font-size: 1.2rem;
    background-color:#febd68;
    color:black;
}
.nav-search:hover{
    border:2px solid orange;
}
/* box4 */
.select2{
    height:40px;
    width:45px;
    background-color: #0f1111;
    align-content: center;
    justify-content: center;
}
.lang{
    color:white;
    background-color: #0f1111;
    display:flex;
    font-size:0.7rem;
}
/* box5 */
span{
    font-size:0.5rem;

}
.nav-second{
    font-size:0.6rem;
    font-weight: 700;
}
/* box7 */
.nav-cart i{
    font-size:22px;

}
.nav-cart {
    font-size:0.7rem;
    font-weight:700;
}
/* panel */
.panel{
    height:40px;
    background-color:#222f3d;
    display:flex;
    align-items: center;
    justify-content: center;
    color:white;
}
.panel-option p{
  display:inline;
  margin-left: 15px;
}
.panel-option{
    width:90%;
    font-size:10px;
}
/* hero_section */
.hero-section{
    background-image:url("hero_image.jpg");
    background-size: cover;
    height:210px;
    display:flex;
    align-items:flex-end;
    justify-content: center;
    
}
.hero-msg{
    background-color:white;
    color:black;
    height:25px;
    display:flex;
    align-items:center;
    justify-content: center;
    margin-bottom: 20px;
    width:95%;
    font-size:0.7rem;
}
a{
    color:#007185;
}
/* shop-section */
.shop-section{
    display:flex;
    flex-wrap:wrap;
    justify-content: space-evenly;
    background-color:#e2e7e6;
}
.box{
    height:300px;
    width:22%;
    /* border:2px solid black; */
    margin-top:15px;
    background-color:white;
    padding:27px 0px 20px;

}
.game-img{
    height:210px;
    background-size:cover;
    margin-top:0.5rem;
    margin-bottom:0.3rem;
}
 
.box-content{
    margin-left:1rem;
    margin-right: 1rem;
}
h2{
    font-size:1rem;
}
.box-content p{
    font-size: x-small;
    color:#007185;
}
/* footer */
.foot-panel1{
    height:30px;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color:#374751;
    color:white;
    font-size:0.7rem;
    margin-top:10px;
}
.foot-panel2{
    height:300px;
    background-color:#222f3d;
    display:flex;
    color:white;
    justify-content: space-evenly;
}
ul a{
    display:block;
    color:#DDDDDD;
    font-size:0.7rem;
    margin-top:10px;
}
ul {
    margin-top:30px;
}
.foot-panel3{
    background-color:#222f3d;
    height:70px;
    border-top: 0.5px solid white;
    display:flex;
    justify-content: center;
    align-items: center;
}
.logo-panel{
    background-image: url("logo.3..jpg");
    background-size:cover;
    height:50px;
    width:90px;
    
}
.foot-panel4{
    background-color:#0f1111 ;
    color:white;
    height:80px;
    font-size:0.8rem;
    text-align:center;
}
.pages a{
    color:white;
    margin-left:7px;
}
.pages{
    padding-top:25px;
    font-size:0.6rem;
}
.copyright{
   
    padding-top:5px;
    font-size:0.6rem;
}
